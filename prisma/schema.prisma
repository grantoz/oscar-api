// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // provider        = "prisma-client-js"
  provider   = "prisma-client" // ESM-first
  engineType = "client"        // No rust engines
  previewFeatures = ["relationJoins", "driverAdapters"]
  output          = "./generated"
  runtime         = "deno"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

model Post {
  id        BigInt   @db.BigInt @default(autoincrement()) @unique
  title     String   @db.VarChar(255)
  content   String?
  published Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  userId    BigInt   @db.BigInt
  extId     String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?
}

enum Role {
  super
  admin
  staff
  user
}

// https://www.prisma.io/docs/orm/prisma-client/queries/custom-models

model User {
  id        BigInt    @db.BigInt @default(autoincrement()) @unique
  email     String    @unique
  name      String?   @db.VarChar(255)
  phone     String?   @db.VarChar(255)
  salt      String?   @db.VarChar(32)
  hash      String?   @db.VarChar(255)
  props     Json?
  role      Role      @default(user)
  extId     String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?
  posts     Post[]
}

model Country {
  id String @db.VarChar(2) @unique
  name             String    @db.VarChar(64)
  alpha3           String   @db.VarChar(3)
  countryCode      Int
  region           String?   @db.VarChar(255)
  subRegion        String?   @db.VarChar(255)
  regionCode       Int?
  subRegionCode    Int?
}

