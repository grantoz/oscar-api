// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  // provider        = "prisma-client-js"
  provider   = "prisma-client" // ESM-first
  engineType = "client"        // No rust engines
  previewFeatures = ["relationJoins"]
  output          = "./generated"
  runtime         = "deno"
}

datasource db {
  provider = "postgresql"
}

model Post {
  id        String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  title     String    @db.VarChar(255)
  content   String?
  published Boolean   @default(false)
  user      User      @relation(fields: [userId], references: [id])
  userId    String    @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?
}

enum Role {
  super
  admin
  staff
  user
}

// https://www.prisma.io/docs/orm/prisma-client/queries/custom-models

model User {
  id        String    @unique @default(dbgenerated("uuidv7()")) @db.Uuid
  email     String    @unique
  name      String?   @db.VarChar(255)
  phone     String?   @db.VarChar(255)
  salt      String?   @db.VarChar(32)
  hash      String?   @db.VarChar(255)
  props     Json?
  role      Role      @default(user)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  deletedAt DateTime?
  verifiedAt DateTime?
  posts     Post[]
}

model Country {
  id              String  @db.VarChar(2) @unique
  name            String  @db.VarChar(64)
  alpha3          String  @db.VarChar(3)
  countryCode     Int
  region          String? @db.VarChar(255)
  regionCode      Int?
  subRegion       String? @db.VarChar(255)
  subRegionCode   Int?
}

