{
  "name": "oscar-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/main.ts",
    "start": "node --env-file=.env --import tsx src/main.ts",
    "test": "node --env-file=.env.test --import tsx --test --test-force-exit --test-concurrency=1 'src/**/*.test.ts'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "db:create": "node --env-file=.env cli/alter_db.js --create",
    "db:drop": "node --env-file=.env cli/alter_db.js --drop",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:new": "node --env-file=.env cli/alter_db.js --drop --create && npm run db:migrate",
    "db:new:seed": "node --env-file=.env cli/alter_db.js --drop --create && npm run db:migrate && npm run db:seed",
    "db:seed": "node --env-file=.env --import tsx prisma/seed/index.ts",
    "setup:all": "npm run setup:env && npm run db:generate && npm run db:new:seed",
    "setup:env": "node cli/setup_env.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@hono/node-server": "^2.1.5",
    "@hono/otel": "^1.2.0",
    "@hono/standard-validator": "^0.4.0",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "hono-openapi": "^1.3.2",
    "ky": "^2.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-opentelemetry-transport": "^4.0.2",
    "pino-pretty": "^13.2.0",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.11.10",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
