{
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "dev:otel": "OTEL_DENO=true deno run --unstable-otel -A --watch src/main.ts",
    "db:create": "deno run -A cli/alter_db.js --create",
    "db:drop": "deno run -A cli/alter_db.js --drop",
    "db:fresh": "deno run -A cli/alter_db.js --drop --create && deno task db:migrate",
    "db:migrate": "deno run -A npm:prisma migrate dev",
    "db:seed": "deno run -A ./prisma/seed/index.ts",
    "test:db:create": "deno run -A --env-file=.env.test cli/alter_db.js --create",
    "test:db:drop": "deno run -A --env-file=.env.test cli/alter_db.js --drop",
    "test:db:fresh": "deno run -A --env-file=.env.test cli/alter_db.js --drop --create && deno task test:db:migrate",
    "test:db:migrate": "deno run --env-file=.env.test -A npm:prisma migrate dev",
    "test:db:seed": "deno run -A --env-file=.env.test ./prisma/seed/index.ts",
    "test": "deno test -A --env-file=.env.test src/",
    "sendemail": "deno run -A --env-file=.env src/send_email.ts"
  },
  "imports": {
    "generated/": "./node_modules/generated/",
    "@hono": "npm:hono",
    "@hono/zod-validator": "npm:@hono/zod-validator",
    "@std/assert" : "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/log": "jsr:@std/log@^0.224.11",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "@zod": "npm:zod"
  },
  "fmt": {
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  },
  "workspace": ["./mod/db"],
  "nodeModulesDir": "auto"
}
