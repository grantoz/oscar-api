{
  "tasks": {
    "dev": "deno run -A --watch src/main.ts",
    "db-create": "deno run -A cli/create_db.js",
    "test": "deno test -A src/"
  },
  "imports": {
    "@nhttp/nhttp": "jsr:@nhttp/nhttp@^2.0.2",
    "@std/assert": "jsr:@std/assert@1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.3",
    "@std/log": "jsr:@std/log@^0.224.11",
    "@std/ulid": "jsr:@std/ulid@^1.0.0",
    "generated/": "./node_modules/generated/"
  },
  "fmt": {
    "semiColons": false
  },
  "workspace": ["./mod/db"],
  "nodeModulesDir": "auto"
}
