{
  "tasks": {
    "dev":      "deno run -A --env-file --watch src/main.ts",
    "dev:test:inspect": "deno run -A --inspect --env-file=.env.test src/main.ts",
    "dev:test": "deno run -A --watch --env-file=.env.test src/main.ts",
    "dev:otel": "OTEL_DENO=true deno run -A --env-file --watch src/main.ts",

    "db:create":        "deno run -A --env-file cli/alter_db.js --create",
    "db:create:test":   "deno run -A --env-file=.env.test cli/alter_db.js --create",

    "db:drop":          "deno run -A --env-file cli/alter_db.js --drop",
    "db:drop:test":     "deno run -A --env-file=.env.test cli/alter_db.js --drop",

    "db:generate":      "rm -rf prisma/generated && rm -rf prisma/zod && node --help && deno task prisma generate --schema ./prisma/schema.prisma && deno run -A cli/patchPrismaZodGeneratorOutput.ts",

    "db:migrate":       "deno run -A --env-file npm:prisma migrate dev",
    "db:migrate:test":  "deno run -A --env-file=.env.test npm:prisma migrate dev",

    "db:new":           "deno run -A --env-file cli/alter_db.js --drop --create && deno task db:migrate",
    "db:new:test":      "deno run -A --env-file=.env.test cli/alter_db.js --drop --create && deno task db:migrate:test",

    "db:new:seed":      "deno run -A --env-file cli/alter_db.js --drop --create && deno task db:migrate && deno task db:seed",
    "db:new:seed:test": "deno run -A --env-file=.env.test cli/alter_db.js --drop --create && deno task db:migrate:test && deno task db:seed:test",

    "db:seed":          "deno run -A --env-file ./prisma/seed/index.ts",
    "db:seed:test":     "deno run -A --env-file=.env.test ./prisma/seed/index.ts --test",

    "prisma":           "deno run -A --env-file npm:prisma",

    "setup:env":        "deno run -A cli/setup_env.js",
    "setup:env:test":   "deno run -A cli/setup_env.js --test",

    "setup:all":        "deno task setup:env && deno task db:generate && deno task db:new:seed",
    "setup:all:test":   "deno task setup:env:test && deno task db:generate && deno task db:new:seed:test",

    "test":             "deno test -A --env-file=.env.test --trace-leaks src/",
    "sendmail":         "deno run -A --env-file src/send_email.ts"
  },
  "unstable": ["kv", "otel"],
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@felix/argon2": "jsr:@felix/argon2@^3.0.2",
    "@hono": "npm:hono@4.10.8",
    "@hono/logger": "npm:hono@4.10.8/logger",
    "@hono/zod-validator": "npm:@hono/zod-validator@0.7.5",
    "@std/assert" : "jsr:@std/assert@^1.0.16",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/expect": "jsr:@std/expect@^1.0.17",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/streams": "jsr:@std/streams@^1.0.14",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@zod": "npm:zod@4.1.13",
    "@util": "./src/util/mod.ts",
    "@/": "./src/"
  },
  "fmt": {
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "exclude": [
      "prisma/generated/**",
      "prisma/zod/**"
    ]
  },
  "workspace": ["./mod/db"],
  "nodeModulesDir": "auto"
}
