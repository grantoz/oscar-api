{
  "tasks": {
    "dev":      "deno run -A --env-file --watch src/main.ts",
    "dev:otel": "OTEL_DENO=true deno run -A --env-file --watch src/main.ts",

    "db:create":        "deno run -A --env-file cli/alter_db.js --create",
    "db:drop":          "deno run -A --env-file cli/alter_db.js --drop",
    "db:generate":      "rm -rf prisma/generated && rm -rf prisma/zod && node --help && deno task prisma generate --schema ./prisma/schema.prisma",
    "db:migrate":       "deno run -A --env-file npm:prisma migrate dev",
    "db:new":           "deno run -A --env-file cli/alter_db.js --drop --create && deno task db:migrate",
    "db:new:seed":      "deno run -A --env-file cli/alter_db.js --drop --create && deno task db:migrate && deno task db:seed",
    "db:seed":          "deno run -A --env-file ./prisma/seed/index.ts",

    "prisma":           "deno run -A --env-file npm:prisma",
    "sendmail":         "deno run -A --env-file src/send_email.ts",

    "setup:all":        "deno task setup:env && deno task db:generate && deno task db:new:seed",
    "setup:env":        "deno run -A cli/setup_env.js",

    "test":             "deno test -A --env-file=.env.test --trace-leaks src/",
    "test:db:create":   "deno run -A --env-file=.env.test cli/alter_db.js --create",
    "test:db:drop":     "deno run -A --env-file=.env.test cli/alter_db.js --drop",
    "test:db:migrate":  "deno run -A --env-file=.env.test npm:prisma migrate dev",
    "test:db:new":      "deno run -A --env-file=.env.test cli/alter_db.js --drop --create && deno task test:db:migrate",
    "test:db:new:seed": "deno run -A --env-file=.env.test cli/alter_db.js --drop --create && deno task test:db:migrate && deno task test:db:seed",
    "test:db:seed":     "deno run -A --env-file=.env.test ./prisma/seed/index.ts --test",
    "test:dev": "deno run -A --watch --env-file=.env.test src/main.ts",
    "test:dev:inspect": "deno run -A --inspect --env-file=.env.test src/main.ts",
    "test:setup:all":   "deno task test:setup:env && deno task db:generate && deno task test:db:new:seed",
    "test:setup:env":   "deno run -A cli/setup_env.js --test"
  },
  "unstable": ["kv", "otel"],
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@felix/argon2": "jsr:@felix/argon2@^3.0.6",
    "@hono": "jsr:@hono/hono@^4.13.5",
    "@hono/zod-validator": "jsr:@hono/zod-validator@^0.9.1",
    "@std/assert" : "jsr:@std/assert@^1.0.19",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/encoding": "jsr:@std/encoding@^1.0.11",
    "@std/expect": "jsr:@std/expect@^1.0.20",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/streams": "jsr:@std/streams@^1.1.2",
    "@zod": "npm:zod@4.4.3",
    "@faker": "https://deno.land/x/deno_faker@v1.0.3/locale/en_AU.ts",
    "@util": "./src/util/mod.ts",
    "@middleware": "./src/middleware/mod.ts",
    "@/": "./src/"
  },
  "fmt": {
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true
  },
  "lint": {
    "exclude": [
      "prisma/generated/**",
      "prisma/zod/**"
    ]
  },
  "workspace": ["./mod/db"],
  "nodeModulesDir": "auto"
}
