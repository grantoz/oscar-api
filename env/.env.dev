# APP_ENV = dev | test | ci | staging | uat | sandbox | prod
APP_ENV=dev
# APP_KEY=secret
PORT=8000
TZ=UTC

LOG_COLORS=true
LOG_DB_QUERIES=true
LOG_DB_INFO=true
# LOG_DB_SLOW_QUERIES=false
# LOG_DB_SLOW_QUERIES_THRESHOLD=1000 # in milliseconds
# LOG_FORMAT = json | text (any value other than these will be interpreted as "text")
LOG_FORMAT=text
LOG_LEVEL=debug

DATABASE_URL=postgresql://user:pass@localhost:5432/oscar?schema=public

OTEL_DENO=true
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT
OTEL_RESOURCE_ATTRIBUTES=env=dev
OTEL_SERVICE_NAME=oscar

# HS512 requires at least 64 bytes key length
JWT_SECRET=
JWT_ALGORITHM=HS512
JWT_ISSUER=oscar-localhost
# 1 hour in seconds
JWT_EXPIRY=3600
# 1 week in seconds
REFRESH_EXPIRY=604800
REFRESH_COOKIE_OPTIONS="HttpOnly; Secure; SameSite=Strict"

#TODO everything below this line is yet to be implemented
JWT_AUDIENCE=localhost
JWT_SUBJECT=localhost
USER_FEDERATION_URL=
USER_FEDERATION_DOMAIN=

# OAUTH2_PROVIDER=
# OAUTH2_CLIENT_ID=
# OAUTH2_CLIENT_SECRET=
# OAUTH2_TOKEN_URL=
# OAUTH2_AUTH_URL=
# OAUTH2_USER_URL=
# OAUTH2_USER_INFO_URL=
# OAUTH2_USER_INFO_SCOPE=
# OAUTH2_USER_INFO_AUDIENCE=
# OAUTH2_USER_INFO_JWKS_URL=
# OAUTH2_USER_INFO_JWKS_CACHE_TTL=3600
# OAUTH2_USER_INFO_JWKS_CACHE_SIZE=1000
# OAUTH2_USER_INFO_JWKS_CACHE_ENABLED=true
# OAUTH2_USER_INFO_JWKS_CACHE_BACKEND=memory
