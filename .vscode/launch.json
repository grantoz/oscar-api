  "version": "0.2.0",
  "configurations": [
    {
      "attachSimplePort": 9229,
      "cwd": "${workspaceFolder}",
      "env": {},
      "name": "Debug Server",
      // "program": "${workspaceFolder}/src/main.ts",
      "request": "launch",
      "runtimeExecutable": "deno",
      "runtimeArgs": [
        "task",
        "dev:test:inspect",
      ],
      "type": "node",
    },
    {
      "attachSimplePort": 9229,
      "console": "integratedTerminal", // WE NEED THIS otherwise we don't get the output
      // "cwd": "${workspaceFolder}",
      "env": {},
      "name": "Debug Tests",
      "program": "${file}", // THIS was required, not the above, otherwise it never finished
      "request": "launch",
      // "program": "${workspaceFolder}/main.ts", /* disabled specific entrypoint */
      "runtimeExecutable": "deno", /* modified: using deno process name from my PATH */
      "runtimeArgs": [
        "test",
        "-A",
        "--env-file=.env.test",
        "--inspect-brk",
      ],
      "type": "node",
    }
  ]
}