# APP_ENV = dev | test | ci | stage | uat | sandbox | prod
APP_ENV=dev
APP_NAME=oscar
APP_KEY=secret
DEBUG=true
PORT=8000

LOG_LEVEL=DEBUG
LOG_DB_QUERY=false
LOG_DB_INFO=false
# LOG_DB_SLOW_QUERIES=false
# LOG_DB_SLOW_QUERIES_THRESHOLD=1000 # in milliseconds

# either DB_URL *or* all of: DB_USER, DB_PASS, DB_HOST, DB_PORT, DB_DB, DB_SCHEMA
DB_URL=postgresql://user:pass@localhost:5432/oscar_test?schema=public
DB_USER=user
DB_PASS=pass
DB_HOST=localhost
DB_PORT=5432
DB_DB=oscar_test
DB_SCHEMA=public

# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT
OTEL_SERVICE_NAME=oscar
# OTEL_RESOURCE_ATTRIBUTES
# OTEL_METRIC_EXPORT_INTERVAL default 60

# HS512 requires at least 64 bytes key length
JWT_SECRET=s7jpuTJ70l6Iff7UsiwhyRSS/i2SbCOMdwuXghl70vCle3djmlJR7Zhu2nX+nFUytoFBLsdU8VY0Id5+BvYYvg==
JWT_ALGORITHM=HS512
JWT_EXPIRATION=3600
JWT_ISSUER=oscar-localhost
#TODO everything below this line is yet to be implemented
JWT_AUDIENCE=localhost
JWT_SUBJECT=localhost

USER_FEDERATION_URL=
USER_FEDERATION_DOMAIN=

OAUTH2_PROIDER=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_TOKEN_URL=
OAUTH2_AUTH_URL=
OAUTH2_USER_URL=
OAUTH2_USER_INFO_URL=
OAUTH2_USER_INFO_SCOPE=
OAUTH2_USER_INFO_AUDIENCE=
OAUTH2_USER_INFO_JWKS_URL=
OAUTH2_USER_INFO_JWKS_CACHE_TTL=3600
OAUTH2_USER_INFO_JWKS_CACHE_SIZE=1000
OAUTH2_USER_INFO_JWKS_CACHE_ENABLED=true
OAUTH2_USER_INFO_JWKS_CACHE_BACKEND=memory
